{
  "name": "bridge-inspection-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3002",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "postinstall": "prisma generate",
    "db:push": "node --env-file=.env.local node_modules/prisma/build/index.js db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:backfill-format": "tsx prisma/backfill-format.ts",
    "db:migrate": "node --env-file=.env.local node_modules/prisma/build/index.js migrate dev"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1071.0",
    "@prisma/client": "^6.7.0",
    "exceljs": "^4.4.0",
    "jszip": "^3.10.1",
    "next": "14.2.29",
    "react": "^18",
    "react-dom": "^18"
  },
  "devDependencies": {
    "@netlify/functions": "^2.8.0",
    "@netlify/plugin-nextjs": "^5.15.11",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "^10.4.27",
    "dotenv": "^17.4.2",
    "eslint": "^8",
    "eslint-config-next": "14.2.29",
    "postcss": "^8",
    "prisma": "^6.7.0",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.21.0",
    "typescript": "^5"
  }
}
