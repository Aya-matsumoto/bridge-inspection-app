generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model InspectionRecord {
  id              Int      @id @default(autoincrement())
  officeNo        Int
  mainOffice      String
  subOffice       String
  routeNo         Int
  bridgeName      String
  spanNo          String?
  distanceMarker  String?
  damageType      String
  location        String
  elementNo       String?
  discoveryDate   DateTime
  measureStatus   String
  measureDate     DateTime?
  measurePlan     String?
  notes           String?
  status          String   @default("draft")
  deletedAt       DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  photos          Photo[]
}

model Photo {
  id             Int              @id @default(autoincrement())
  recordId       Int
  record         InspectionRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)
  type           String
  filePath       String
  originalName   String
  annotationData   String?
  originalFilePath String?
  createdAt        DateTime         @default(now())
}

model SubOfficeMaster {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  mainOffice  String
  format      String   @default("normal") // normal | kp_range | kp_point
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AdminSession {
  id        String   @id
  createdAt DateTime @default(now())
  expiresAt DateTime
}

model User {
  id             Int           @id @default(autoincrement())
  loginId        String        @unique
  password       String
  displayName    String
  allowedOffices String        @default("all")
  isAdmin        Boolean       @default(false)
  isActive       Boolean       @default(true)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  sessions       UserSession[]
}

model UserSession {
  id        String   @id
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  expiresAt DateTime
}

model BridgeMaster {
  id             Int      @id @default(autoincrement())
  sortOrder      String   @default("")
  subOffice      String
  bridgeName     String
  routeNo        Int
  distanceMarker String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}
